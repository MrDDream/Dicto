{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dicto",
  "version": "0.1.7",
  "identifier": "app.dicto.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Dicto",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      },
      {
        "label": "pill",
        "title": "Dicto — pastille",
        "url": "pill.html",
        "width": 300,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage", "dmg"],
    "category": "Productivity",
    "shortDescription": "Dictée vocale, en local ou en ligne",
    "longDescription": "Dicto transcrit ta voix et écrit le texte dans la fenêtre active. Les modèles tournent sur l'ordinateur ; les services en ligne sont en option.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"]
      }
    }
  }
}
